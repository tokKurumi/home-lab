# ============================================================================
# MONITORING STACK (PROMETHEUS + GRAFANA) - Storage Configuration
# ============================================================================
#
# Three storage profiles are available:
#
# 1. NAMED VOLUME (default) - Best for most users
#    - Docker manages storage automatically
#    - Data persists across container restarts
#    - Easy to backup with Docker commands
#    - Usage: docker compose -f docker-compose.yml up -d
#
# 2. NAMED VOLUME WITH CUSTOM PATH - Recommended for production
#    - Named volumes point to custom storage via HOST_VOLUMES_DIR
#    - Single environment variable controls all storage paths
#    - Usage: HOST_VOLUMES_DIR=/mnt/nas docker compose -f docker-compose.yml -f docker-compose.volumes.yml up -d
#
# 3. BIND MOUNT - For advanced users / per-service control
#    - Store data in specific directories (local, NAS, cloud mount)
#    - Full control over individual service storage locations
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.bind.yml up -d
#
# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# For NAMED VOLUME WITH CUSTOM PATH profile, set the base directory:
# Default: ./docker-volumes (relative to docker-compose.yml)
# Examples:
#   HOST_VOLUMES_DIR=./docker-volumes                    (local, default)
#   HOST_VOLUMES_DIR=/mnt/nas/docker-volumes             (NAS via NFS/CIFS)
#   HOST_VOLUMES_DIR=/mnt/external-drive/docker-volumes  (external drive)
# Leave commented to use default ./docker-volumes
# HOST_VOLUMES_DIR=./docker-volumes

# For BIND MOUNT profile, set the grafana data path:
# Examples:
#   HOST_GRAFANA_DATA=./docker-volumes/monitoring/grafana  (default)
#   HOST_GRAFANA_DATA=/mnt/nas/grafana                      (NAS)
#   HOST_GRAFANA_DATA=/mnt/external-drive/grafana           (external drive)
# Leave commented to use default ./docker-volumes/monitoring/grafana
# HOST_GRAFANA_DATA=./docker-volumes/monitoring/grafana

# For BIND MOUNT profile, set the prometheus data path:
# Examples:
#   HOST_PROMETHEUS_DATA=./docker-volumes/monitoring/prometheus  (default)
#   HOST_PROMETHEUS_DATA=/mnt/nas/prometheus                      (NAS)
#   HOST_PROMETHEUS_DATA=/mnt/external-drive/prometheus           (external drive)
# Leave commented to use default ./docker-volumes/monitoring/prometheus
# HOST_PROMETHEUS_DATA=./docker-volumes/monitoring/prometheus

################################################################################
# Grafana Configuration
################################################################################

# Admin username (default: admin)
GF_SECURITY_ADMIN_USER=admin

# Admin password (change this! default: admin)
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana instance name
GF_INSTANCE_NAME=Home Lab Monitoring

# Domain where Grafana is accessible
# Used for links, email notifications, etc.
# GF_SERVER_DOMAIN=grafana.example.com
# GF_SERVER_ROOT_URL=https://grafana.example.com/

# Enable/disable user signup
GF_USERS_ALLOW_SIGN_UP=false

# Default organization role for new users
GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer

################################################################################
# Prometheus Configuration
################################################################################

# Scrape interval (how often to collect metrics)
# Format: 15s, 1m, 5m, etc.
PROMETHEUS_SCRAPE_INTERVAL=15s

# Evaluation interval (how often to evaluate alerts)
PROMETHEUS_EVALUATION_INTERVAL=15s

# Metrics retention (how long to keep metrics)
# Format: 15d, 30d, 90d, etc.
PROMETHEUS_RETENTION=15d

################################################################################
# Node Exporter Configuration
################################################################################

# Textfile collectors directory (optional)
# NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

################################################################################
# Container Names (internal DNS resolution)
################################################################################

# These are used for inter-container communication
# Usually no need to change these
GRAFANA_HOST=grafana
PROMETHEUS_HOST=prometheus
NODE_EXPORTER_HOST=node_exporter
CADVISOR_HOST=cadvisor
