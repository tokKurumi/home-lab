# ============================================================================
# OPENSPEEDTEST - Storage Configuration
# ============================================================================
#
# Three storage profiles are available:
#
# 1. NAMED VOLUMES with Custom Path (Recommended) ✅
#    - Store data on external drive, NAS, or specific path
#    - Single configuration variable (HOST_VOLUMES_DIR)
#    - Portable and easy to migrate
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.volumes.yml up -d
#
# 2. BIND MOUNT - For advanced users with per-volume control
#    - Store volume on different drive/NAS
#    - Full granular control over paths
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.bind.yml up -d
#
# 3. DOCKER-MANAGED VOLUMES (default, not recommended)
#    - Data stored on system drive in /var/lib/docker/volumes/
#    - No configuration needed
#    - Usage: docker compose up -d
#
# ============================================================================

# Named Volumes Profile (Recommended)
# Base directory where all volumes will be stored
# Used by docker-compose.volumes.yml
# Default: ./docker-volumes
HOST_VOLUMES_DIR=./docker-volumes

# Directory structure (created automatically):
#   $HOST_VOLUMES_DIR/speedtest/
#   └── openspeedtest/
#       └── appdata/    (speedtest data and configuration)

# ============================================================================
# Bind Mount Profile (Advanced - Optional)
# Individual path variable for volume
# Only needed if using docker-compose.bind.yml with custom paths
# ============================================================================

# OpenSpeedTest data directory
HOST_SPEEDTEST_APPDATA=./docker-volumes/speedtest/openspeedtest/appdata

# Examples with NAS paths:
# HOST_SPEEDTEST_APPDATA=/mnt/nas/speedtest/appdata

# ============================================================================
