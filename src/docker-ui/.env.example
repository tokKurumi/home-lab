# ============================================================================
# PORTAINER - Storage Configuration
# ============================================================================
#
# Three storage profiles are available:
#
# 1. DOCKER-MANAGED VOLUMES (Not Recommended)
#    - Fastest setup, no configuration needed
#    - Data stored in /var/lib/docker/volumes/ (system drive)
#    - Limited to single machine, hard to migrate
#    - Best for: Testing only
#    - Usage: docker compose -f docker-compose.yml up -d
#
# 2. NAMED VOLUMES WITH CUSTOM PATH (Recommended) ✅
#    - Best for most users and production deployments
#    - Data stored on custom path via HOST_VOLUMES_DIR
#    - Single environment variable for all volumes
#    - Portable between hosts (volumes are named references)
#    - Easy migration: change variable, copy directory
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.volumes.yml up -d
#    - Default: ./docker-volumes (same directory as docker-compose.yml)
#
# 3. BIND MOUNTS (Advanced - Per-service Customization)
#    - Fine-grained control over each volume path
#    - Useful for complex setups or multiple storage backends
#    - Requires individual variable configuration
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.bind.yml up -d
#
# ============================================================================

# PROFILE 2: Named Volumes with Custom Path (Recommended)
# Uncomment to override the default path (./docker-volumes)
# Examples:
#   HOST_VOLUMES_DIR=./docker-volumes                 (relative, default)
#   HOST_VOLUMES_DIR=/mnt/nas/docker-volumes          (NAS mount)
#   HOST_VOLUMES_DIR=/mnt/storage/docker-volumes      (external SSD)
# HOST_VOLUMES_DIR=./docker-volumes

# PROFILE 3: Bind Mounts (Per-Service Paths)
# Uncomment to override individual volume paths
# Examples:
#   HOST_PORTAINER_DATA=/mnt/nas/docker-ui/portainer  (custom path)
# HOST_PORTAINER_DATA=./docker-volumes/docker-ui/portainer

# ============================================================================
# PORTAINER Configuration
# ============================================================================

# Timezone for Portainer (default: Europe/Moscow)
TZ=Europe/Moscow
