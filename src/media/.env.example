# Media Stack Environment Variables
# Copy this file to .env and customize as needed

################################################################################
# Storage Configuration
################################################################################

# Base directory where all volumes/data will be stored
# Used by BOTH docker-compose.volumes.yml AND docker-compose.bind.yml
# Default: ./docker-volumes
HOST_VOLUMES_DIR=./docker-volumes

# Directory structure (created automatically):
#   $HOST_VOLUMES_DIR/media/
#   ├── config/          (service configurations)
#   │   ├── wireguard/
#   │   ├── qbittorrent/
#   │   ├── prowlarr/
#   │   ├── lidarr/
#   │   ├── radarr/
#   │   ├── sonarr/
#   │   ├── jellyfin/
#   │   └── jellyseerr/
#   ├── fileflows/       (processing files)
#   │   ├── temp/
#   │   ├── data/
#   │   └── common/
#   └── data/            (media content)

# Advanced per-service path variables (for docker-compose.bind.yml only):
# These allow maximum flexibility - point each service to different locations
# Example: Config on SSD, media on NAS, temp files on separate drive
HOST_WIREGUARD_CONFIG=./docker-volumes/media/config/wireguard
HOST_QBITTORRENT_CONFIG=./docker-volumes/media/config/qbittorrent
HOST_PROWLARR_CONFIG=./docker-volumes/media/config/prowlarr
HOST_LIDARR_CONFIG=./docker-volumes/media/config/lidarr
HOST_RADARR_CONFIG=./docker-volumes/media/config/radarr
HOST_SONARR_CONFIG=./docker-volumes/media/config/sonarr
HOST_FILEFLOWS_TEMP=./docker-volumes/media/fileflows/temp
HOST_FILEFLOWS_DATA=./docker-volumes/media/fileflows/data
HOST_FILEFLOWS_COMMON=./docker-volumes/media/fileflows/common
HOST_JELLYFIN_CONFIG=./docker-volumes/media/config/jellyfin
HOST_JELLYSEERR_CONFIG=./docker-volumes/media/config/jellyseerr
HOST_MEDIA_DATA=./docker-volumes/media/data

################################################################################
# WireGuard VPN Configuration (Client-side)
################################################################################

# WireGuard server endpoint (provided by VPN provider)
WIREGUARD_ENDPOINT_IP=192.168.0.1
WIREGUARD_ENDPOINT_PORT=51820

# WireGuard keys (generate client-side with: wg genkey | tee privatekey | wg pubkey > publickey)
# Note: Server-side keys and configuration are managed by VPN provider
WIREGUARD_PUBLIC_KEY=your_public_key_here
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PRESHARED_KEY=your_preshared_key_here

# WireGuard IP addresses (provided by VPN provider)
WIREGUARD_ADDRESSES=10.8.0.1/24

################################################################################
# qBittorrent Configuration
################################################################################

# Web UI port (default: 8080)
# Accessible at: http://localhost:8080 (via Wireguard)
QBIT_WEBUI_PORT=8080

# Torrent connection port (default: 6881)
QBIT_CONNECTION_PORT=6881

################################################################################
# Jellyfin Network Ports
################################################################################

# Jellyfin local network discovery (default: 7359)
JELLYFIN_DISCOVERY_PORT=7359

# Jellyfin DLNA discovery (default: 1900)
JELLYFIN_DLNA_PORT=1900

################################################################################
# Discord Music Bot Configuration
################################################################################

# Discord bot token (create at https://discord.com/developers/applications)
DISCORD_CLIENT_TOKEN=your_discord_bot_token_here

# Jellyfin credentials for music bot
JELLYFIN_AUTHENTICATION_USERNAME=your_jellyfin_username
JELLYFIN_AUTHENTICATION_PASSWORD=your_jellyfin_password

################################################################################
# User & System Configuration
################################################################################

# Timezone (default: Europe/Moscow)
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
TZ=Europe/Moscow