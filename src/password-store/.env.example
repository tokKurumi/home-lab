# ============================================================================
# PASSWORD STORE (VAULTWARDEN) - Storage Configuration
# ============================================================================
#
# Three storage profiles are available:
#
# 1. NAMED VOLUME (default) - Best for most users
#    - Docker manages storage automatically
#    - Data persists across container restarts
#    - Easy to backup with Docker commands
#    - Usage: docker compose -f docker-compose.yml up -d
#
# 2. NAMED VOLUME WITH CUSTOM PATH - Recommended for production
#    - Named volumes point to custom storage via HOST_VOLUMES_DIR
#    - Single environment variable controls all storage paths
#    - Usage: HOST_VOLUMES_DIR=/mnt/nas docker compose -f docker-compose.yml -f docker-compose.volumes.yml up -d
#
# 3. BIND MOUNT - For advanced users / per-service control
#    - Store data in specific directories (local, NAS, cloud mount)
#    - Full control over individual service storage locations
#    - Usage: docker compose -f docker-compose.yml -f docker-compose.bind.yml up -d
#
# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# For NAMED VOLUME WITH CUSTOM PATH profile, set the base directory:
# Default: ./docker-volumes (relative to docker-compose.yml)
# Examples:
#   HOST_VOLUMES_DIR=./docker-volumes                    (local, default)
#   HOST_VOLUMES_DIR=/mnt/nas/docker-volumes             (NAS via NFS/CIFS)
#   HOST_VOLUMES_DIR=/mnt/external-drive/docker-volumes  (external drive)
# Leave commented to use default ./docker-volumes
# HOST_VOLUMES_DIR=./docker-volumes

# For BIND MOUNT profile, set the vaultwarden data path:
# Examples:
#   HOST_VAULTWARDEN_DATA=./docker-volumes/password-store/vaultwarden  (default)
#   HOST_VAULTWARDEN_DATA=/mnt/nas/vaultwarden                          (NAS)
#   HOST_VAULTWARDEN_DATA=/mnt/external-drive/vaultwarden               (external drive)
# Leave commented to use default ./docker-volumes/password-store/vaultwarden
# HOST_VAULTWARDEN_DATA=./docker-volumes/password-store/vaultwarden

# ============================================================================
# VAULTWARDEN Domain Configuration
# ============================================================================
# The HTTPS domain where Vaultwarden is accessible
# This is used for correct redirect URIs and API calls from clients
VAULTWARDEN_DOMAIN=https://passwords.lan

# ============================================================================
# VAULTWARDEN Invitation Token (optional)
# ============================================================================
# Required to allow new user registrations via invitation
# Generate with: openssl rand -hex 32
# Leave empty to disable invitations
# INVITATION_ORG_NAME=
# INVITATION_TOKEN=
